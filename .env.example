# ClipForge AI Environment Configuration

# Backend Host & Port
HOST=127.0.0.1
PORT=8000

# Hardware & Engine Tuning (Optimized for 8GB RAM Core i5 PC)
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=4

FFMPEG_PRESET=ultrafast
FFMPEG_THREADS=2

# Concurrency Limit (Prevents RAM thrashing)
MAX_CONCURRENT_JOBS=1

# SQLite Database Location
DATABASE_URL=sqlite:///clipforge.db
